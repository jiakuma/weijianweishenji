# ===== 应用 =====
APP_NAME=audit-work-platform
APP_HOST=0.0.0.0
APP_PORT=5281
WEB_PORT=5280

# ===== 数据库 =====
# postgres = PostgreSQL 15（标准栈，需先安装服务并填下面参数）
# sqlite   = 本地单机降级路径，仅用于开发验证，不作为生产配置
DB_BACKEND=sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=audit_platform
DB_PASSWORD=
DB_DATABASE=audit_platform
DB_SCHEMA=audit_platform
# 本地降级的 SQLite 文件（相对 server 目录）；留空则使用 server/data/knowledge.db
DB_URL=

# ===== 中台 SSO + JWT =====
# local   = 保留现有本机令牌，仅开发验证
# sso     = 接入中台 SSO + extractauth + 自签 JWT 双 cookie
AUTH_MODE=local
JWT_SECRET_KEY=
SESSION_EXPIRE_SECONDS=86400
COOKIE_SECURE=false
SSO_TRIGGER_HEADER=eywaauth
# 统一认证平台地址；纯服务间调用可留空，嵌入场景必填
SSO_HOST=
AI_PLATFORM_HOST=
AI_PLATFORM_AUTH_KEY=
# 免认证路径（逗号分隔），新业务接口默认不进白名单
AUTH_EXEMPT_PATHS=/,/health,/api/health

# ===== 大模型 =====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== 向量检索 =====
MILVUS_URI=
EMBED_MODEL=BAAI/bge-small-zh-v1.5

# ===== 前端（web/.env） =====
VITE_API_BASE=http://localhost:5281
# 仅当后端 AUTH_MODE=sso 且前后端跨域部署时设为 true；local 模式保持 false
VITE_WITH_CREDENTIALS=false
